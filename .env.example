# Copy to `.env` (git-ignored) and fill in. NEVER commit real values.
#
# Server: generate the WireGuard key with:  wg genkey
ZKVPN_PRIVATE_KEY=
# Comma-separated ZK identities allowed to connect (empty = any valid identity!)
ZKVPN_AUTHORIZED_IDENTITIES=
ZKVPN_PORT=51820
ZKVPN_ADMISSION_PORT=51821
ZKVPN_NETWORK_CIDR=10.0.0.0/24
ZKVPN_LOG_LEVEL=INFO
